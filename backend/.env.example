# -------------------------------------------------------------
# Resume AI Agent - Local-first configuration
# -------------------------------------------------------------

# =========================
# Chat / generation model
# =========================
# Options: lmstudio, ollama, huggingface, openai, gemini, custom
LLM_PROVIDER=lmstudio
LLM_CONCURRENCY=1

# LM Studio (recommended zero-cost local setup)
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Set these to the exact identifier of the chat model loaded in LM Studio.
LLM_MODEL=your-loaded-lm-studio-model
EXTRACTOR_MODEL=your-loaded-lm-studio-model
ADVISOR_MODEL=your-loaded-lm-studio-model

# Ollama alternative
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

# Hosted providers (optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=

# Generic OpenAI-compatible server (optional)
LLM_BASE_URL=
LLM_API_KEY=local

# =========================
# Embeddings
# =========================
# Recommended: fully local Python embeddings; no API key/server required.
# Options: sentence_transformers, lmstudio, ollama, huggingface, openai, gemini, custom
EMBEDDING_PROVIDER=sentence_transformers
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Leave empty for automatic CPU/GPU selection by sentence-transformers.
LOCAL_EMBED_DEVICE=
LOCAL_EMBED_NORMALIZE=true

# Only needed when EMBEDDING_PROVIDER uses an OpenAI-compatible endpoint.
EMBED_BASE_URL=
EMBED_API_KEY=local
EMBED_MODEL=
EMBED_DIM=768

# =========================
# Job source
# =========================
# fixture = fully offline demo/testing, no SerpApi key required
# serpapi = live Google Jobs results
JOB_SOURCE=fixture
LOCAL_JOBS_FIXTURE=fixtures/jobs.json

SERPAPI_API_KEY=
SERPAPI_GOOGLE_DOMAIN=google.com
SERPAPI_GL=
SERPAPI_HL=en
SERPAPI_TIMEOUT_SECONDS=30
SERPAPI_NO_CACHE=false

# =========================
# Qdrant
# =========================
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
# Use a different collection when changing embedding model/dimension.
QDRANT_COLLECTION=google_jobs_local_minilm

# =========================
# Email MCP
# =========================
EMAIL_MCP_TRANSPORT=streamable_http
EMAIL_MCP_URL=http://127.0.0.1:9000/mcp
EMAIL_MCP_COMMAND=
EMAIL_MCP_ARGS_JSON=[]
EMAIL_MCP_TOOL_NAME=send_email
