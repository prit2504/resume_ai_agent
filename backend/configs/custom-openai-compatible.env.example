# Any OpenAI-compatible chat server, such as a local inference gateway.
LLM_PROVIDER=custom
LLM_BASE_URL=http://127.0.0.1:8001/v1
LLM_API_KEY=local
LLM_MODEL=your-model-id
EXTRACTOR_MODEL=your-model-id
ADVISOR_MODEL=your-model-id
LLM_CONCURRENCY=1

# Either keep embeddings local:
EMBEDDING_PROVIDER=sentence_transformers
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Or use a separate OpenAI-compatible embedding endpoint:
# EMBEDDING_PROVIDER=custom
# EMBED_BASE_URL=http://127.0.0.1:8002/v1
# EMBED_API_KEY=local
# EMBED_MODEL=your-embedding-model
# EMBED_DIM=768

JOB_SOURCE=fixture
LOCAL_JOBS_FIXTURE=fixtures/jobs.json

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=google_jobs_custom

EMAIL_MCP_TRANSPORT=streamable_http
EMAIL_MCP_URL=http://127.0.0.1:9000/mcp
EMAIL_MCP_TOOL_NAME=send_email
