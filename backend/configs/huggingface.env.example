# Hugging Face hosted inference through its OpenAI-compatible router.
# A Hugging Face token is required. Free account limits depend on HF policy/account.
LLM_PROVIDER=huggingface
HF_TOKEN=your_huggingface_token

LLM_MODEL=your-huggingface-chat-model
EXTRACTOR_MODEL=your-huggingface-chat-model
ADVISOR_MODEL=your-huggingface-chat-model
LLM_CONCURRENCY=2

# Embeddings stay fully local and key-free.
EMBEDDING_PROVIDER=sentence_transformers
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

JOB_SOURCE=fixture
LOCAL_JOBS_FIXTURE=fixtures/jobs.json

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=google_jobs_hf_minilm

EMAIL_MCP_TRANSPORT=streamable_http
EMAIL_MCP_URL=http://127.0.0.1:9000/mcp
EMAIL_MCP_TOOL_NAME=send_email
