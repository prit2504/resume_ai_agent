# Zero-cost local setup: Ollama chat + local sentence-transformers embeddings
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=ollama

LLM_MODEL=gemma3:4b
EXTRACTOR_MODEL=gemma3:4b
ADVISOR_MODEL=gemma3:4b
LLM_CONCURRENCY=1

EMBEDDING_PROVIDER=sentence_transformers
LOCAL_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
LOCAL_EMBED_DEVICE=
LOCAL_EMBED_NORMALIZE=true

JOB_SOURCE=fixture
LOCAL_JOBS_FIXTURE=fixtures/jobs.json

QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=google_jobs_local_minilm

EMAIL_MCP_TRANSPORT=streamable_http
EMAIL_MCP_URL=http://127.0.0.1:9000/mcp
EMAIL_MCP_TOOL_NAME=send_email
